rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner ka poora data: sirf owner padh/likh sakta hai
    match /businesses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Worker ka apna hisaab: worker sirf padh sakta hai, likh sirf owner sakta hai
      match /views/{wuid} {
        allow read: if request.auth != null && (request.auth.uid == wuid || request.auth.uid == uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Business code -> owner. Koi bhi code check kar sakta hai, naya code sirf owner bana sakta hai
    match /codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && !request.auth.token.email.matches('.*@workers[.]invalid');
      allow update, delete: if false;
    }
  }
}
